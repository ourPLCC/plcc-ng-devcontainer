{
    "name": "plcc-ng-devcontainer (repo development)",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {},
        // moby:false installs Docker CE instead of Moby. The base image tag
        // floats, and it has rolled forward to Ubuntu 26.04 "resolute", for
        // which no moby-cli packages exist yet — with the default the feature
        // aborts and the container will not open. Revisit once moby packages
        // catch up, or drop this line if the base is ever pinned to an older
        // release.
        "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false },
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    // The change-request tracker and org developer docs live in ourPLCC/dev,
    // cloned beside this repo on the host and mounted at /workspaces/dev.
    // A Codespace cannot provide that clone, so this repo is developed in
    // VS Code on your own machine. ~/.claude is a named volume so assistant
    // memory and settings survive a rebuild.
    "initializeCommand": "test -d ../dev || git clone https://github.com/ourPLCC/dev ../dev; git -C ../dev config core.hooksPath .githooks",
    "mounts": [
        "source=${localWorkspaceFolder}/../dev,target=/workspaces/dev,type=bind",
        "source=plcc-ng-devcontainer-claude,target=/home/vscode/.claude,type=volume"
    ],
    "containerEnv": {
        "BACKLOG_CWD": "/workspaces/dev",
        "GIT_CONFIG_COUNT": "2",
        "GIT_CONFIG_KEY_0": "safe.directory",
        "GIT_CONFIG_VALUE_0": "/workspaces/dev",
        "GIT_CONFIG_KEY_1": "safe.directory",
        "GIT_CONFIG_VALUE_1": "${containerWorkspaceFolder}"
    },
    "postCreateCommand": "sudo chown vscode:vscode /home/vscode/.claude && npm i -g backlog.md@$(cat /workspaces/dev/.backlog-version) && git -C /workspaces/dev status >/dev/null && git -C ${containerWorkspaceFolder} status >/dev/null && ${containerWorkspaceFolder}/bin/install/claude-imports.bash && npm install -g @devcontainers/cli"
}
